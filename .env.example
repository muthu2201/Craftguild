# --- Runtime ---
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=https://api.craftguild.example
TRUST_PROXY=true

# --- Datastores ---
DATABASE_URL=postgres://user:password@host:5432/craftguild
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000
REDIS_URL=redis://host:6379

# --- Secrets (never commit real values) ---
JWT_SECRET=<at least 48 random characters in production>
JWT_TTL_SECONDS=3600
PASSWORD_PEPPER=<optional server-side pepper>

# --- Payment aggregator: Cashfree Payments (PG + Easy Split) ---
CASHFREE_BASE_URL=https://api.cashfree.com
CASHFREE_APP_ID=<merchant app id>
CASHFREE_SECRET_KEY=<merchant secret key>
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=<webhook signing secret>
CASHFREE_TIMEOUT_MS=12000
CASHFREE_MAX_RETRIES=3

# --- Commercial policy ---
PLATFORM_FEE_PERCENT=10
TIP_FEE_PERCENT=0
PG_FEE_PERCENT=2.0
SPLIT_FEE_PERCENT=0.25
RESERVE_PERCENT=10
MINIMUM_PAYOUT_RUPEES=100
FIRST_PAYOUT_HOLD_DAYS=7

# --- Settlement cycle ---
SETTLEMENT_ACCRUAL_DAYS=30
SETTLEMENT_GRACE_DAYS=5

# --- Risk and throttling ---
MAX_TOPUP_PER_HOUR=10
MAX_TOPUP_VALUE_PER_DAY_RUPEES=50000
RATE_LIMIT_AUTH_BURST=10
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PAYMENT_BURST=10
RATE_LIMIT_PAYMENT_PER_MINUTE=30
RATE_LIMIT_UNLOCK_BURST=60
RATE_LIMIT_UNLOCK_PER_MINUTE=240
RATE_LIMIT_ONBOARD_BURST=5
RATE_LIMIT_ONBOARD_PER_MINUTE=10
